# ===============================================
# AURA MUSIC PRO - CONFIGURACIÓN DEL SERVIDOR
# ===============================================

PORT=3001
NODE_ENV=development

# 🍃 MONGODB ATLAS (Base de datos principal)
# Pega aquí tu cadena de conexión de MongoDB Atlas:
# Ejemplo: mongodb+srv://tu_usuario:tu_password@cluster0.abcde.mongodb.net/name-bd?retryWrites=true&w=majority
MONGODB_URI=

# 🔐 SEGURIDAD JWT (Firma de tokens de autenticación)
JWT_SECRET=secret

# ☁️ CLOUDFLARE R2 (Almacenamiento de fotos de perfil y multimedia)
# Obtenidos en Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=aura-media

# URL pública de tu bucket R2 (Opcional si habilitaste dominio personalizado o r2.dev)
# Si lo dejas vacío, el servidor actuará automáticamente como proxy local/nube.
R2_PUBLIC_URL=
